# =============================================================================
# hybrid-data-svc configuration
# =============================================================================
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_DB=datasvc
POSTGRES_USER=datasvc
POSTGRES_PASSWORD=change-me-strong-password

# Internal URL used by data-svc / bar-grpc inside the docker network.
# When running scripts on the host, use localhost:5432 instead.
POSTGRES_URL=postgresql://datasvc:change-me-strong-password@postgres:5432/datasvc

# -----------------------------------------------------------------------------
# Feeds — what to scrape
# -----------------------------------------------------------------------------
# Primary feed (single-symbol mode)
SYMBOL=BTC/USDT:USDT
TV_SYMBOL=BINANCE:BTCUSDTPERP
TIMEFRAME=1h

# Multi-feed rotation (overrides SYMBOL/TV_SYMBOL/TIMEFRAME if set).
# Format: db_key@timeframe@tv_symbol  (comma-separated tuples).
# Example covering 5 symbols × 6 timeframes:
# FEEDS=BTC/USDT:USDT@15@BINANCE:BTCUSDTPERP,BTC/USDT:USDT@30@BINANCE:BTCUSDTPERP,BTC/USDT:USDT@1h@BINANCE:BTCUSDTPERP,...

# -----------------------------------------------------------------------------
# Polling and storage
# -----------------------------------------------------------------------------
BARS_TO_FETCH=300
POLL_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# gRPC server
# -----------------------------------------------------------------------------
GRPC_LISTEN=0.0.0.0:50051

# -----------------------------------------------------------------------------
# REST gateway (bar-rest)
# -----------------------------------------------------------------------------
REST_LISTEN_HOST=0.0.0.0
REST_LISTEN_PORT=8001
# Target for BarService gRPC calls (/v1/quote, /healthz).
GRPC_TARGET=bar-grpc:50051
# If unset/empty: REST is open (suitable for a private docker network).
# If set: every /v1/* request must carry Authorization: Bearer <token>.
# /healthz is always open.
REST_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Chrome DevTools Protocol (TradingView Desktop tab pinning)
# -----------------------------------------------------------------------------
# CDP_HOST is auto-resolved to host.docker.internal IPv4 by docker-entrypoint.sh.
# CDP_PORT is auto-discovered by data_svc.cdp_discover: probes a cached port
# first (~/.cache/tv-mcp/cdp-port.json), then scans 9222-9230 for any port
# whose /json/list reports a tradingview chart tab. The chosen port is cached
# for fast startup on subsequent runs.
#
# Override either by uncommenting below (e.g. multi-TV setup, debugging,
# or a custom --remote-debugging-port outside the scan range):
# CDP_HOST=localhost
# CDP_PORT=9222
# TV_MCP_PORT_RANGE=9222-9240  # override scan range
