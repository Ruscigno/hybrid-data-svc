# =============================================================================
# hybrid-data-svc configuration
# =============================================================================
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_DB=datasvc
POSTGRES_USER=datasvc
POSTGRES_PASSWORD=change-me-strong-password

# Internal URL used by data-svc / bar-grpc inside the docker network.
# When running scripts on the host, use localhost:5432 instead.
POSTGRES_URL=postgresql://datasvc:change-me-strong-password@postgres:5432/datasvc

# -----------------------------------------------------------------------------
# Feeds — what to scrape
# -----------------------------------------------------------------------------
# Primary feed (single-symbol mode)
SYMBOL=BTC/USDT:USDT
TV_SYMBOL=BINANCE:BTCUSDTPERP
TIMEFRAME=1h

# Multi-feed rotation (overrides SYMBOL/TV_SYMBOL/TIMEFRAME if set).
# Format: db_key@timeframe@tv_symbol  (comma-separated tuples).
# Example covering 5 symbols × 6 timeframes:
# FEEDS=BTC/USDT:USDT@15@BINANCE:BTCUSDTPERP,BTC/USDT:USDT@30@BINANCE:BTCUSDTPERP,BTC/USDT:USDT@1h@BINANCE:BTCUSDTPERP,...

# -----------------------------------------------------------------------------
# Polling and storage
# -----------------------------------------------------------------------------
BARS_TO_FETCH=300
POLL_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# gRPC server
# -----------------------------------------------------------------------------
GRPC_LISTEN=0.0.0.0:50051

# -----------------------------------------------------------------------------
# Chrome DevTools Protocol (TradingView Desktop tab pinning)
# -----------------------------------------------------------------------------
# Auto-resolved by docker-entrypoint.sh inside the container.
# CDP_HOST=localhost
# CDP_PORT=9222
