# =============================================================================
# Secrets — never commit
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
credentials.json
secrets.json

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =============================================================================
# Data — runtime state only, never commit
# =============================================================================
data/
*.db
*.db-journal
*.db-wal
*.db-shm
pgdata/
backups/

# =============================================================================
# gRPC generated stubs
# =============================================================================
# The proto-derived stubs in data_svc/grpc_server/proto/ ARE committed
# (regenerated via `buf generate` — see Makefile target `proto`). CI's
# proto-codegen-verify step diffs them on every PR. We still ignore the
# pattern globally so any *other* future *_pb2.py from third-party imports,
# tests, etc. don't sneak in.
*_pb2.py
*_pb2_grpc.py
*_pb2.pyi
!data_svc/grpc_server/proto/*_pb2.py
!data_svc/grpc_server/proto/*_pb2_grpc.py
!data_svc/grpc_server/proto/*_pb2.pyi

# =============================================================================
# Node (TV-MCP submodule build artifacts; submodule itself is tracked)
# =============================================================================
node_modules/

# =============================================================================
# OS / Editor
# =============================================================================
.DS_Store
.idea/
.vscode/
*.swp
*~
